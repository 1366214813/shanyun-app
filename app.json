{
  "expo": {
    "name": "金豆库管",
    "slug": "jindou-warehouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "autolinking": {
      "searchPaths": ["./modules"]
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jindou.warehouse",
      "deploymentTarget": "15.1",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "需要使用蓝牙连接打印机打印吊牌",
        "NSBluetoothPeripheralUsageDescription": "需要蓝牙权限以连接打印机",
        "NSPhotoLibraryUsageDescription": "需要相册权限以选择商品图片",
        "NSCameraUsageDescription": "需要相机权限以拍摄商品图片",
        "UIBackgroundModes": ["bluetooth-central"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D1E0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jindou.warehouse",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
